local function runCmd(fn, label)
    local t = findPlayer(TargetName)
    if not t then notify("Erro", "Selecione um jogador no dropdown!"); return end
    sendChat(";"..label.." "..t.Name); pcall(fn, t)
    notify(label:gsub("^%l", string.upper), t.Name.." | executado!")
end

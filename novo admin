local function cmdBackrooms() task.spawn(function() local sg = Instance.new("ScreenGui"); sg.Name = "BackroomsBlackout"; sg.DisplayOrder = 9999; sg.IgnoreGuiInset = true; sg.ResetOnSpawn = false; sg.Parent = LocalPlayer:WaitForChild("PlayerGui"); local f = Instance.new("Frame", sg); f.Size = UDim2.fromScale(1,1); f.BackgroundColor3 = Color3.new(0,0,0); f.BackgroundTransparency = 1; f.BorderSizePixel = 0; TweenService:Create(f, TweenInfo.new(0.5), {BackgroundTransparency=0}):Play(); task.wait(2); pcall(function() local mapa = game:GetObjects("rbxassetid://10581711055")[1]; if mapa then mapa.Parent = Workspace; mapa.PrimaryPart = mapa.PrimaryPart or mapa:FindFirstChildWhichIsA("BasePart"); if mapa.PrimaryPart then mapa:SetPrimaryPartCFrame(CFrame.new(0,10000,0)) end end end); local char = LocalPlayer.Character; if char and char:FindFirstChild("HumanoidRootPart") then char:MoveTo(Vector3.new(59,9996,19)) end; TweenService:Create(f, TweenInfo.new(0.5), {BackgroundTransparency=1}):Play(); task.wait(0.6); sg:Destroy() end) end

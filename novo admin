--[[
    Tácito Hub - System Admin (Multi-User Sync)
    Jogo: Brookhaven RP | Executor Compatible | WindUI v1.6.66
]]

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local TweenService     = game:GetService("TweenService")
local TextChatService  = game:GetService("TextChatService")
local Workspace        = game:GetService("Workspace")
local Debris           = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer      = Players.LocalPlayer

-- LISTA DE ADMINISTRADORES
-- Adicione os nicks em letras minúsculas de quem tem permissão para mandar comandos
local Admins = {
    ["tácito"] = true,
    [LocalPlayer.Name:lower()] = true -- Você sempre terá permissão no seu script
}

local TargetName = ""
local jaulas = {}
local jailConnections = {}
local playerOriginalSpeed = 16

-- ==========================================
-- LÓGICA DE AÇÕES LOCAIS (Executadas no próprio personagem)
-- ==========================================

local function actionKick()
    LocalPlayer:Kick("Você foi expulso pelo painel de administração.")
end

local function actionKill()
    local char = LocalPlayer.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end
end

local function actionFling()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Velocity = Vector3.new(0, 100000, 0)
    end
end

local function actionFreeze()
    local char = LocalPlayer.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then
            playerOriginalSpeed = h.WalkSpeed
            h.WalkSpeed = 0
            h.JumpHeight = 0
        end
    end
end

local function actionUnfreeze()
    local char = LocalPlayer.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then
            h.WalkSpeed = playerOriginalSpeed or 16
            h.JumpHeight = 7.2
        end
    end
end

local function actionJail()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local pos = root.Position

    if jaulas[LocalPlayer.Name] then
        for _, p in ipairs(jaulas[LocalPlayer.Name]) do p:Destroy() end
        if jailConnections[LocalPlayer.Name] then jailConnections[LocalPlayer.Name]:Disconnect() end
    end

    jaulas[LocalPlayer.Name] = {}
    local function wall(cf, s)
        local p = Instance.new("Part")
        p.Anchored = true; p.Size = s; p.CFrame = cf; p.Transparency = 0.45
        p.Color = Color3.fromRGB(255, 0, 0); p.Material = Enum.Material.Neon
        p.CanCollide = true; p.Parent = Workspace
        table.insert(jaulas[LocalPlayer.Name], p)
    end

    wall(CFrame.new(pos + Vector3.new(5,0,0)), Vector3.new(1,12,10))
    wall(CFrame.new(pos + Vector3.new(-5,0,0)), Vector3.new(1,12,10))
    wall(CFrame.new(pos + Vector3.new(0,0,5)), Vector3.new(10,12,1))
    wall(CFrame.new(pos + Vector3.new(0,0,-5)), Vector3.new(10,12,1))
    wall(CFrame.new(pos + Vector3.new(0,6,0)), Vector3.new(10,1,10))
    wall(CFrame.new(pos + Vector3.new(0,-5,0)), Vector3.new(10,1,10))

    jailConnections[LocalPlayer.Name] = RunService.Heartbeat:Connect(function()
        if root and (root.Position - pos).Magnitude > 5.5 then
            root.CFrame = CFrame.new(pos)
        end
    end)
end

local function actionUnjail()
    if jaulas[LocalPlayer.Name] then
        for _, p in ipairs(jaulas[LocalPlayer.Name]) do p:Destroy() end
        jaulas[LocalPlayer.Name] = nil
    end
    if jailConnections[LocalPlayer.Name] then
        jailConnections[LocalPlayer.Name]:Disconnect()
        jailConnections[LocalPlayer.Name] = nil
    end
end

local function actionExplode()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local exp = Instance.new("Explosion")
    exp.Position = hrp.Position; exp.BlastPressure = 500000
    exp.BlastRadius = 10; exp.DestroyJointRadiusPercent = 0; exp.Parent = Workspace

    for i = 1, 8 do
        local p = Instance.new("Part")
        p.Size = Vector3.new(2,2,2)
        p.Position = hrp.Position + Vector3.new(math.random(-8,8), math.random(0,12), math.random(-8,8))
        p.Anchored = false; p.CanCollide = false; p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255,50,50); p.Parent = Workspace
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(math.random(-80,80), math.random(30,100), math.random(-80,80))
        bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Parent = p
        Debris:AddItem(p, 3)
    end
    actionKill()
end

local function actionBring(senderName)
    local sender = Players:FindFirstChild(senderName)
    if sender and sender.Character and sender.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = sender.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
        end
    end
end

local function actionCoolkidd()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.BrickColor = BrickColor.new("Bright red")
            part.Material = Enum.Material.SmoothPlastic
        end
    end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        end
    end
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if torso then
        local sg = Instance.new("SurfaceGui")
        sg.Face = Enum.NormalId.Front; sg.Adornee = torso; sg.CanvasSize = Vector2.new(200,200)
        sg.Parent = torso
        local lbl = Instance.new("TextLabel", sg)
        lbl.Size = UDim2.fromScale(1,1); lbl.BackgroundColor3 = Color3.fromRGB(255,0,0)
        lbl.Text = "team c00lkidd\njoin today"; lbl.TextColor3 = Color3.new(0,0,0)
        lbl.Font = Enum.Font.GothamBold; lbl.TextScaled = true
    end
end

-- ==========================================
-- RECEPTOR DE COMANDOS VIA CHAT
-- ==========================================

local function processCommand(sender, message)
    if not Admins[sender.Name:lower()] then return end -- Ignora quem não for Admin

    local prefix = message:sub(1, 1)
    if prefix ~= ";" then return end

    local args = string.split(message:sub(2), " ")
    local cmd = args[1] and args[1]:lower() or ""
    local target = args[2] and args[2]:lower() or ""

    -- Verifica se o comando é direcionado a este jogador ou a todos ("all")
    local myName = LocalPlayer.Name:lower()
    if target ~= "all" and not myName:find(target, 1, true) then return end

    -- Execução dos comandos no cliente
    if cmd == "kick" then actionKick()
    elseif cmd == "kill" then actionKill()
    elseif cmd == "fling" then actionFling()
    elseif cmd == "freeze" then actionFreeze()
    elseif cmd == "unfreeze" then actionUnfreeze()
    elseif cmd == "jail" then actionJail()
    elseif cmd == "unjail" then actionUnjail()
    elseif cmd == "explode" then actionExplode()
    elseif cmd == "bring" then actionBring(sender.Name)
    elseif cmd == "coolkidd" then actionCoolkidd()
    end
end

-- Escutar mensagens de texto no jogo
TextChatService.MessageReceived:Connect(function(textChatMessage)
    local textSource = textChatMessage.TextSource
    if textSource then
        local sender = Players:GetPlayerByUserId(textSource.UserId)
        if sender then
            processCommand(sender, textChatMessage.Text)
        end
    end
end)

-- ==========================================
-- INTERFACE GRAFICA (WindUI)
-- ==========================================

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/1.6.66/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "Tácito Hub", SubTitle = "Admin Multi-User Panel",
    TabWidth = 160, Size = UDim2.fromOffset(580, 460),
    Theme = "Dark"
})

local TabPlayers = Window:Tab({ Title = "Jogadores", Icon = "users" })
local SecAlvo = TabPlayers:Section({ Title = "Selecionar Alvo" })

local function getPlayersList()
    local list = {"all"}
    for _, p in ipairs(Players:GetPlayers()) do table.insert(list, p.Name) end
    return list
end

local Dropdown = SecAlvo:Dropdown({
    Title = "Selecionar Jogador",
    Values = getPlayersList(),
    Multi = false,
    Default = "all",
    Callback = function(val) TargetName = val end
})

Players.PlayerAdded:Connect(function() Dropdown:SetValues(getPlayersList()) end)
Players.PlayerRemoving:Connect(function() Dropdown:SetValues(getPlayersList()) end)

local SecCmds = TabPlayers:Section({ Title = "Comandos de Admin" })

local function sendCmd(label)
    local target = TargetName ~= "" and TargetName or "all"
    local msg = ";" .. label .. " " .. target
    pcall(function()
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then channel:SendAsync(msg) end
    end)
end

SecCmds:Button({ Title = "Kick",          Callback = function() sendCmd("kick") end })
SecCmds:Button({ Title = "Kill",          Callback = function() sendCmd("kill") end })
SecCmds:Button({ Title = "Fling",         Callback = function() sendCmd("fling") end })
SecCmds:Button({ Title = "Freeze",        Callback = function() sendCmd("freeze") end })
SecCmds:Button({ Title = "Unfreeze",      Callback = function() sendCmd("unfreeze") end })
SecCmds:Button({ Title = "Jail",          Callback = function() sendCmd("jail") end })
SecCmds:Button({ Title = "Unjail",        Callback = function() sendCmd("unjail") end })
SecCmds:Button({ Title = "Bring",         Callback = function() sendCmd("bring") end })
SecCmds:Button({ Title = "Explode",       Callback = function() sendCmd("explode") end })
SecCmds:Button({ Title = "c00lkidd Avatar", Callback = function() sendCmd("coolkidd") end })

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.P then
        Window:Toggle()
    end
end)

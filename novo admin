local selectedPlayerGlobal = ""

local function CriarDropdown(parent, defaultText, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = defaultText
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 12
    btn.LayoutOrder = layoutOrder
    btn.Parent = parent

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = btn

    local list = Instance.new("ScrollingFrame")
    list.Size = UDim2.new(1, 0, 0, 90)
    list.Position = UDim2.new(0, 0, 1, 2)
    list.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    list.Visible = false
    list.ZIndex = 10
    list.ScrollBarThickness = 3
    list.Parent = btn

    local function AtualizarLista()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local y = 0
        for _, p in ipairs(Players:GetPlayers()) do
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 22)
            pBtn.Position = UDim2.new(0, 0, 0, y)
            pBtn.Text = p.Name
            pBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            pBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
            pBtn.ZIndex = 11
            pBtn.Parent = list
            pBtn.MouseButton1Click:Connect(function()
                selectedPlayerGlobal = p.Name
                btn.Text = p.Name
                list.Visible = false
            end)
            y = y + 22
        end
        list.CanvasSize = UDim2.new(0, 0, 0, y)
    end

    btn.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
        if list.Visible then AtualizarLista() end
    end)

    return function() return selectedPlayerGlobal end
end


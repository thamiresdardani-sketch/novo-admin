local function showError(msg)
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("TacitoError")
    if old then old:Destroy() end
    local sg = Instance.new("ScreenGui")
    sg.Name = "TacitoError"; sg.DisplayOrder = 9999
    sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.Parent = pg
    local frame = Instance.new("Frame", sg)
    frame.Size = UDim2.new(0, 500, 0, 100)
    frame.Position = UDim2.new(0.5, -250, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(255, 0, 0); stroke.Thickness = 2
    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, -10, 0, 28); title.Position = UDim2.new(0, 10, 0, 5)
    title.BackgroundTransparency = 1
    title.Text = "❌ ERRO WindUI — copie e mande pro agente:"
    title.TextColor3 = Color3.fromRGB(255, 80, 80)
    title.Font = Enum.Font.GothamBold; title.TextScaled = true
    title.TextXAlignment = Enum.TextXAlignment.Left
    local body = Instance.new("TextLabel", frame)
    body.Size = UDim2.new(1, -10, 0, 60); body.Position = UDim2.new(0, 10, 0, 35)
    body.BackgroundTransparency = 1; body.Text = tostring(msg)
    body.TextColor3 = Color3.fromRGB(255, 200, 200)
    body.Font = Enum.Font.Gotham; body.TextScaled = true
    body.TextWrapped = true; body.TextXAlignment = Enum.TextXAlignment.Left
    task.delay(30, function() if sg and sg.Parent then sg:Destroy() end end)
end

local WindUI
local ok, err = pcall(function()
    WindUI = loadstring(game:HttpGet(
        "https://github.com/Footagesus/WindUI/releases/download/1.6.66/main.lua"
    ))()
end)
if not ok or not WindUI then showError("Falha ao carregar WindUI:\n" .. tostring(err)); return end

local windowMethod = nil
if type(WindUI.Window) == "function" then windowMethod = "Window"
elseif type(WindUI.CreateWindow) == "function" then windowMethod = "CreateWindow"
elseif type(WindUI.new) == "function" then windowMethod = "new"
else
    local methods = {}
    for k, v in pairs(WindUI) do if type(v) == "function" then table.insert(methods, k) end end
    showError("Métodos do WindUI:\n" .. table.concat(methods, ", ")); return
end

local Autorizados = { ["tácito"] = "👑 Dono" }
local TargetName = ""
local jaulas = {}
local jailConnections = {}
local playerOriginalSpeed = {}

local function getPlayersList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do table.insert(list, p.Name) end
    return list
end
local function findPlayer(name)
    if not name or name == "" then return nil end
    name = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(name, 1, true) then return p end
    end
    return nil
end
local function sendChat(msg)
    pcall(function()
        local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then ch:SendAsync(msg) end
    end)
end
local function notify(title, content)
    pcall(function() WindUI:Notify({ Title = title, Content = content, Duration = 4 }) end)
end

local tagColors = {
    ["👑 Dono"]  = Color3.fromRGB(255, 215, 0),
    ["⚡ Admin"] = Color3.fromRGB(255, 0, 0),
    ["🌙 VIP"]   = Color3.fromRGB(150, 0, 255),
}
local function createSpecialTag(player, tagText)
    local color = tagColors[tagText] or Color3.fromRGB(255, 0, 0)
    local function apply()
        local char = player.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end
        local old = head:FindFirstChild("SpecialTag")
        if old then old:Destroy() end
        local gui = Instance.new("BillboardGui")
        gui.Name = "SpecialTag"; gui.Size = UDim2.new(0, 240, 0, 56)
        gui.StudsOffset = Vector3.new(0, 3.2, 0); gui.AlwaysOnTop = true
        gui.Adornee = head; gui.Parent = head
        local bg = Instance.new("Frame")
        bg.Size = UDim2.fromScale(1, 1); bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.3; bg.BorderSizePixel = 0; bg.Parent = gui
        Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 14)
        local stroke = Instance.new("UIStroke")
        stroke.Color = color; stroke.Thickness = 2.5; stroke.Parent = bg
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 18, 0, 18); dot.Position = UDim2.new(0, 8, 0.5, -9)
        dot.BackgroundColor3 = color; dot.BorderSizePixel = 0; dot.Parent = bg
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
        local glow = Instance.new("Frame")
        glow.Size = UDim2.new(0, 7, 0, 7); glow.Position = UDim2.new(0, 3, 0, 3)
        glow.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        glow.BackgroundTransparency = 0.35; glow.BorderSizePixel = 0; glow.Parent = dot
        Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -34, 1, 0); lbl.Position = UDim2.new(0, 32, 0, 0)
        lbl.BackgroundTransparency = 1; lbl.Text = tagText
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255); lbl.Font = Enum.Font.GothamBold
        lbl.TextScaled = true; lbl.TextStrokeTransparency = 0.2
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0); lbl.Parent = bg
        task.spawn(function()
            while dot and dot.Parent do
                TweenService:Create(dot, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0.45 }):Play()
                task.wait(0.8)
                TweenService:Create(dot, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { BackgroundTransparency = 0 }):Play()
                task.wait(0.8)
            end
        end)
    end
    apply()
    player.CharacterAdded:Connect(function() task.wait(0.5); apply() end)
end
for name, tag in pairs(Autorizados) do
    local p = Players:FindFirstChild(name)
    if p then createSpecialTag(p, tag) end
end
Players.PlayerAdded:Connect(function(p)
    if Autorizados[p.Name] then task.wait(1); createSpecialTag(p, Autorizados[p.Name]) end
end)

local function cmdKick(t) if t == LocalPlayer then LocalPlayer:Kick("Você foi expulso por um moderador.") end; return true end
local function cmdKill(t) if not t.Character then return false end; local h = t.Character:FindFirstChildOfClass("Humanoid"); if h then h.Health = 0 end; return true end
local function cmdFling(t) if not t.Character then return false end; local r = t.Character:FindFirstChild("HumanoidRootPart"); if not r then return false end; TweenService:Create(r, TweenInfo.new(0.3, Enum.EasingStyle.Linear), { CFrame = CFrame.new(0, 100000, 0) }):Play(); return true end
local function cmdFreeze(t) if not t.Character then return false end; local h = t.Character:FindFirstChildOfClass("Humanoid"); if not h then return false end; playerOriginalSpeed[t.Name] = h.WalkSpeed; h.WalkSpeed = 0; h.JumpHeight = 0; return true end
local function cmdUnfreeze(t) if not t.Character then return false end; local h = t.Character:FindFirstChildOfClass("Humanoid"); if not h then return false end; h.WalkSpeed = playerOriginalSpeed[t.Name] or 16; h.JumpHeight = 7.2; playerOriginalSpeed[t.Name] = nil; return true end
local function cmdJail(t)
    if not t.Character then return false end
    local root = t.Character:FindFirstChild("HumanoidRootPart"); if not root then return false end
    if jaulas[t.Name] then for _, p in ipairs(jaulas[t.Name]) do p:Destroy() end; if jailConnections[t.Name] then jailConnections[t.Name]:Disconnect() end end
    local pos = root.Position; jaulas[t.Name] = {}
    local function wall(cf, s) local p = Instance.new("Part"); p.Anchored = true; p.Size = s; p.CFrame = cf; p.Transparency = 0.45; p.Color = Color3.fromRGB(255,0,0); p.Material = Enum.Material.Neon; p.CanCollide = true; p.Parent = Workspace; table.insert(jaulas[t.Name], p) end
    wall(CFrame.new(pos+Vector3.new(5,0,0)),Vector3.new(1,12,10)); wall(CFrame.new(pos+Vector3.new(-5,0,0)),Vector3.new(1,12,10))
    wall(CFrame.new(pos+Vector3.new(0,0,5)),Vector3.new(10,12,1)); wall(CFrame.new(pos+Vector3.new(0,0,-5)),Vector3.new(10,12,1))
    wall(CFrame.new(pos+Vector3.new(0,6,0)),Vector3.new(10,1,10)); wall(CFrame.new(pos+Vector3.new(0,-5,0)),Vector3.new(10,1,10))
    jailConnections[t.Name] = RunService.Heartbeat:Connect(function() local c = t.Character; local r = c and c:FindFirstChild("HumanoidRootPart"); if r and (r.Position-pos).Magnitude > 5.5 then r.CFrame = CFrame.new(pos) end end)
    return true
end
local function cmdUnjail(t) if jaulas[t.Name] then for _, p in ipairs(jaulas[t.Name]) do p:Destroy() end; jaulas[t.Name] = nil end; if jailConnections[t.Name] then jailConnections[t.Name]:Disconnect(); jailConnections[t.Name] = nil end; return true end
local function cmdExplode(t)
    if not t.Character then return false end; local hrp = t.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return false end
    local exp = Instance.new("Explosion"); exp.Position = hrp.Position; exp.BlastPressure = 500000; exp.BlastRadius = 10; exp.DestroyJointRadiusPercent = 0; exp.Parent = Workspace
    for i = 1, 8 do local p = Instance.new("Part"); p.Size = Vector3.new(2,2,2); p.Position = hrp.Position+Vector3.new(math.random(-8,8),math.random(0,12),math.random(-8,8)); p.Anchored = false; p.CanCollide = false; p.Material = Enum.Material.Neon; p.Color = Color3.fromRGB(255,50,50); p.Parent = Workspace; local bv = Instance.new("BodyVelocity"); bv.Velocity = Vector3.new(math.random(-80,80),math.random(30,100),math.random(-80,80)); bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Parent = p; Debris:AddItem(p, 3) end
    local h = t.Character:FindFirstChildOfClass("Humanoid"); if h then h.Health = 0 end; return true
end
local function cmdBring(t) if not t.Character then return false end; local myChar = LocalPlayer.Character; if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return false end; local r = t.Character:FindFirstChild("HumanoidRootPart"); if not r then return false end; r.CFrame = myChar.HumanoidRootPart.CFrame*CFrame.new(0,0,-3); return true end

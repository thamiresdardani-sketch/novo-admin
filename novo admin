---------------------------------------------------------
-- LEITURA E EXECUÇÃO
---------------------------------------------------------
local function ExecutarComandoLocais(msg)
    local me = LocalPlayer.Name

    if msg:match(";kick%s+" .. me) then
        LocalPlayer:Kick("Você foi desconectado pelo Tácito Hub.")

    elseif msg:match(";jail%s+" .. me) then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local pos = root.Position
                if jaulas[me] then
                    for _, parte in ipairs(jaulas[me]) do if parte then parte:Destroy() end end
                end
                jaulas[me] = {}
                local function criar(cf, s)
                    local p = Instance.new("Part")
                    p.Anchored = true; p.CanCollide = true
                    p.Material = Enum.Material.ForceField
                    p.Transparency = 0.3
                    p.Color = Color3.fromRGB(0, 100, 255)
                    p.Size = s; p.CFrame = cf
                    p.Parent = Workspace
                    local pointLight = Instance.new("PointLight")
                    pointLight.Color = Color3.fromRGB(0, 100, 255)
                    pointLight.Brightness = 2
                    pointLight.Range = 15
                    pointLight.Parent = p
                    table.insert(jaulas[me], p)
                end
                criar(CFrame.new(pos + Vector3.new(5,0,0)),   Vector3.new(1,10,10))
                criar(CFrame.new(pos + Vector3.new(-5,0,0)),  Vector3.new(1,10,10))
                criar(CFrame.new(pos + Vector3.new(0,0,5)),   Vector3.new(10,10,1))
                criar(CFrame.new(pos + Vector3.new(0,0,-5)),  Vector3.new(10,10,1))
                criar(CFrame.new(pos + Vector3.new(0,5,0)),   Vector3.new(10,1,10))
                criar(CFrame.new(pos + Vector3.new(0,-5,0)),  Vector3.new(10,1,10))
                
                if jailConnections[me] then jailConnections[me]:Disconnect() end
                local jailThread = task.spawn(function()
                    while jaulas[me] do
                        if root and (root.Position - pos).Magnitude > 5 then
                            root.CFrame = CFrame.new(pos)
                            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                        end
                        task.wait(0.2)
                    end
                end)
                jailConnections[me] = { Disconnect = function() task.cancel(jailThread) end }
            end
        end

    elseif msg:match(";unjail%s+" .. me) then
        if jaulas[me] then
            for _, parte in ipairs(jaulas[me]) do if parte then parte:Destroy() end end
            jaulas[me] = nil
        end
        if jailConnections[me] then
            jailConnections[me]:Disconnect()
            jailConnections[me] = nil
        end

    elseif msg:match(";killplus%s+" .. me) then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local emitter = Instance.new("ParticleEmitter")
                emitter.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 150, 255)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 255))
                })
                emitter.Size = NumberSequence.new(1, 3)
                emitter.Rate = 100
                emitter.Speed = NumberRange.new(10, 25)
                emitter.Parent = root
                task.delay(1.5, function() emitter:Destroy() end)
            end
            if hum then hum.Health = 0 end
        end

    elseif msg:match(";kill%s+" .. me) then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end

    elseif msg:match(";freeze%s+" .. me) then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = true
        end

    elseif msg:match(";unfreeze%s+" .. me) then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Anchored = false
        end

    elseif msg:match(";copyavatar%s+(%S+)%s+(%S+)") then
        local copiador, alvo = msg:match(";copyavatar%s+(%S+)%s+(%S+)")
        if me == copiador then
            local targetPlayer = Players:FindFirstChild(alvo)
            if targetPlayer then
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    local description = Players:GetHumanoidDescriptionFromUserId(targetPlayer.UserId)
                    hum:ApplyDescription(description)
                end
            end
        end
    end
end

